{
  "$schema": "./api/schema/seal.config.schema.json",
  "schemaVersion": 3,
  "packageManager": "npm",
  "build": {
    "entry": "src/index.ts",
    "ecmaTarget": "es6",
    "bundleFileName": "sealdice-js-ext.js"
  },
  "runtime": {
    "allowedGlobals": []
  },
  "sealDice": {
    "profiles": [
      {
        "id": "1.5.0",
        "kind": "exact",
        "runtimeCoreCommit": "aea1014f29cd89f1adc32abbf4da26ac8f03b690"
      },
      {
        "id": "1.5.1",
        "kind": "exact",
        "runtimeCoreCommit": "e3b6c8183966de690df77729507a71be851153a4"
      },
      {
        "id": "1.6.0",
        "kind": "exact",
        "runtimeCoreCommit": "b06a2d92a7af0b8b33be33390206297edf29c7bd",
        "typecheckInclude": ["tests/profiles/1.6.0/**/*.ts"]
      },
      {
        "id": "compat-1.5.x",
        "kind": "compatibility",
        "members": ["1.5.0", "1.5.1"]
      }
    ],
    "defaultTarget": "compat-1.5.x"
  },
  "release": {
    "directory": "release",
    "checksum": "sha256",
    "defaultFormats": ["js"],
    "artifactPolicy": {
      "forbiddenPaths": [],
      "forbiddenExtensions": []
    }
  },
  "sealpack": {
    "packageId": "template/sealdice-js-ext-template",
    "minSealDice": "1.6.0",
    "scriptPath": "scripts/sealdice-js-ext.js",
    "authors": [],
    "keywords": [],
    "repository": "",
    "dependencies": {},
    "permissions": {
      "network": false,
      "networkHosts": [],
      "acknowledgeUnrestrictedNetwork": false,
      "fileRead": [],
      "fileWrite": [],
      "dangerous": false,
      "httpServer": false,
      "ipc": []
    },
    "readme": "README.md",
    "assets": [],
    "store": {
      "category": "tool",
      "icon": "",
      "banner": "",
      "screenshots": []
    }
  }
}
