{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sealdice/sealdice-js-ext-template/seal.config.schema.json",
  "title": "SealDice template configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageManager",
    "build",
    "runtime",
    "sealDice",
    "release",
    "sealpack"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 3 },
    "packageManager": { "const": "npm" },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "ecmaTarget", "bundleFileName"],
      "properties": {
        "entry": { "type": "string", "minLength": 1 },
        "ecmaTarget": { "type": "string", "minLength": 1 },
        "bundleFileName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.js$"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedGlobals"],
      "properties": {
        "allowedGlobals": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sealDice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profiles", "defaultTarget"],
      "properties": {
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "kind", "runtimeCoreCommit"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
                  },
                  "kind": { "const": "exact" },
                  "runtimeCoreCommit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "typecheckInclude": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "kind", "members"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^compat-[a-z0-9][a-z0-9.-]{1,62}$"
                  },
                  "kind": { "const": "compatibility" },
                  "members": {
                    "type": "array",
                    "minItems": 2,
                    "uniqueItems": true,
                    "items": { "type": "string" }
                  }
                }
              }
            ]
          }
        },
        "defaultTarget": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "checksum", "defaultFormats", "artifactPolicy"],
      "properties": {
        "directory": { "const": "release" },
        "checksum": { "const": "sha256" },
        "defaultFormats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["js", "sealpack"] }
        },
        "artifactPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["forbiddenPaths", "forbiddenExtensions"],
          "properties": {
            "forbiddenPaths": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "forbiddenExtensions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^\\.[A-Za-z0-9]+$"
              }
            }
          }
        }
      }
    },
    "sealpack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "minSealDice",
        "scriptPath",
        "authors",
        "keywords",
        "repository",
        "dependencies",
        "permissions",
        "readme",
        "assets",
        "store"
      ],
      "properties": {
        "packageId": { "type": "string", "minLength": 3 },
        "minSealDice": { "type": "string", "minLength": 1 },
        "scriptPath": { "type": "string", "minLength": 1 },
        "authors": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "keywords": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "repository": { "type": "string" },
        "dependencies": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "network",
            "networkHosts",
            "acknowledgeUnrestrictedNetwork",
            "fileRead",
            "fileWrite",
            "dangerous",
            "httpServer",
            "ipc"
          ],
          "properties": {
            "network": { "type": "boolean" },
            "networkHosts": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "acknowledgeUnrestrictedNetwork": { "type": "boolean" },
            "fileRead": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "fileWrite": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "dangerous": { "type": "boolean" },
            "httpServer": { "type": "boolean" },
            "ipc": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "readme": { "const": "README.md" },
        "assets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "store": {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "icon", "banner", "screenshots"],
          "properties": {
            "category": { "type": "string", "minLength": 1 },
            "icon": { "type": "string" },
            "banner": { "type": "string" },
            "screenshots": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
