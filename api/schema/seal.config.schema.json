{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sealdice/sealdice-js-ext-template/seal.config.schema.json",
  "title": "SealDice template configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageManager", "sealDice", "release"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "packageManager": { "const": "npm" },
    "sealDice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profiles", "defaultTarget"],
      "properties": {
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "kind"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
                  },
                  "kind": { "const": "exact" },
                  "typecheckInclude": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "kind", "members"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^compat-[a-z0-9][a-z0-9.-]{1,62}$"
                  },
                  "kind": { "const": "compatibility" },
                  "members": {
                    "type": "array",
                    "minItems": 2,
                    "uniqueItems": true,
                    "items": { "type": "string" }
                  }
                }
              }
            ]
          }
        },
        "defaultTarget": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "checksum"],
      "properties": {
        "directory": { "const": "release" },
        "checksum": { "const": "sha256" }
      }
    }
  }
}
