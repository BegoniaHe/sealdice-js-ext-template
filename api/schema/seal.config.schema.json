{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sealdice/sealdice-js-ext-template/seal.config.schema.json",
  "title": "SealDice template configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageManager", "sealDice", "release"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "packageManager": { "const": "npm" },
    "sealDice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets",
        "defaultTarget",
        "compatibilityProfile",
        "compatibilityTargets"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^1\\.(?:5\\.[01]|6\\.0)$" }
        },
        "defaultTarget": {
          "type": "string",
          "pattern": "^1\\.(?:5\\.[01]|6\\.0)$"
        },
        "compatibilityProfile": { "const": "compat-1.5.x" },
        "compatibilityTargets": {
          "type": "array",
          "const": ["1.5.0", "1.5.1"]
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "checksum"],
      "properties": {
        "directory": { "const": "release" },
        "checksum": { "const": "sha256" }
      }
    }
  }
}
