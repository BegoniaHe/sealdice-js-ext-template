#!/bin/sh
# Project-local SealDice workflow entrypoint. Keep this bootstrap dependency-free.
set -eu

script_dir=$(CDPATH='' cd -P "$(dirname "$0")" && pwd -P)
root=$script_dir

if [ ! -f "$root/package.json" ] || [ ! -f "$root/.nvmrc" ]; then
  printf '%s\n' 'sealw: repository root is incomplete' >&2
  exit 2
fi

if ! command -v node >/dev/null 2>&1; then
  printf '%s\n' 'sealw: Node.js is required; install the version in .nvmrc' >&2
  exit 2
fi

expected=$(tr -d '[:space:]' < "$root/.nvmrc")
actual=$(node -p 'process.versions.node')
if [ "$actual" != "$expected" ]; then
  printf 'sealw: Node.js %s is required by .nvmrc (found %s)\n' "$expected" "$actual" >&2
  exit 2
fi

cd "$root"
exec node tools/cli/main.mjs "$@"
